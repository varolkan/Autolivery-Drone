<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autolivery_drone</name>
  <version>1.0.0</version>
  <description>
    ROS 2 flight stack for the Autolivery delivery drone: mission execution over MAVROS
    (PX4 offboard), gripper control, route planning, ADS-B traffic, and a fake flight
    controller for dry runs.
  </description>
  <maintainer email="148723216+varolkan@users.noreply.github.com">varolkan</maintainer>
  <license>PolyForm-Noncommercial-1.0.0 AND LicenseRef-Autolivery-Additional-Conditions</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>autolivery_core</depend>
  <depend>autolivery_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
